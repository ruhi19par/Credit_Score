DB_URL=jdbc:postgresql://localhost:5432/credbridge
DB_USERNAME=postgres
DB_PASSWORD=change-me
PORT=8080
SERVER_PORT=8080
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_OPEN_IN_VIEW=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=4
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=120
DOCUMENT_UPLOAD_DIR=uploads/documents
DOCUMENT_MAX_FILE_SIZE_BYTES=5242880
DOCUMENT_ASYNC_PROCESSING=false
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_ENCRYPTION_KEY=change-this-32-byte-document-key
DOCUMENT_VIRUS_SCAN_ENABLED=false
DOCUMENT_VIRUS_SCAN_COMMAND=clamscan
DOCUMENT_VIRUS_SCAN_TIMEOUT_SECONDS=30
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
DOCUMENT_S3_PATH_STYLE_ACCESS=true
OCR_PROVIDER=tesseract
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGE=eng
TESSERACT_TIMEOUT_SECONDS=30
AI_ENABLED=true
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_REPORTS_PER_MINUTE=120
RATE_LIMIT_GENERAL_PER_MINUTE=300
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
